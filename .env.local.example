# Copy to .env.local and fill in from your Supabase project:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_
# and never expose it to the browser.
# Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Google Gen AI (Gemini) — used by app/api/decide
GEMINI_API_KEY=

# ⚠️ Server-only. Anthropic — used by app/api/plan (claude-sonnet-4-6)
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# ⚠️ Server-only. Google Maps Platform — used by app/api/plan.
# Enable BOTH "Places API (New)" and "Routes API" on the project,
# then restrict the key to those two APIs.
GOOGLE_MAPS_API_KEY=
